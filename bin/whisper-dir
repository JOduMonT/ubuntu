#!/bin/bash

# Whisper CUDA Transcription - Obsidian/Markdown with Full Path

MODEL_SIZE="${2:-turbo}"
LANGUAGE="${3:-en}"
DEVICE="cuda"

if [ $# -eq 0 ]; then
    echo "Usage: $0 <directory> [model_size] [language]"
    echo "Creates Markdown files with full source path and transcription content"
    exit 1
fi

SEARCH_DIR="$1"

total=0
success=0

echo "================================================"
echo "Whisper → Obsidian Markdown Transcription"
echo "================================================"
echo "Search directory: $SEARCH_DIR"
echo "Model: $MODEL_SIZE"
echo "Language: $LANGUAGE"
echo "================================================"
echo ""

while IFS= read -r -d '' mp3_file; do
    ((total++))
    
    # Get full absolute path
    mp3_full_path=$(realpath "$mp3_file")
    mp3_dir="$(dirname "$mp3_file")"
    filename=$(basename "$mp3_file" .mp3)
    md_file="$mp3_dir/$filename.md"
    temp_txt="$mp3_dir/$filename.txt"
    
    echo "[$total] Processing: $mp3_full_path"
    
    # Run whisper to generate plain text
    if whisper "$mp3_file" \
        --model "$MODEL_SIZE" \
        --language "$LANGUAGE" \
        --device "$DEVICE" \
        --output_dir "$mp3_dir" \
        --output_format txt \
        --fp16 True \
        --verbose False; then
        
        # Get file metadata
        filesize=$(du -h "$mp3_file" | cut -f1)
        created_date=$(date -r "$mp3_file" "+%Y-%m-%d")
        transcribed_date=$(date "+%Y-%m-%d %H:%M")
        
        # Create Markdown file with frontmatter and full path
        cat > "$md_file" << EOF
---
source_path: "$mp3_full_path"
created: $created_date
model: $MODEL_SIZE
language: $LANGUAGE
filesize: $filesize
tags:
  - transcription
  - audio
---
$(cat "$temp_txt")
EOF
        
        # Clean up temporary txt file
        rm -f "$temp_txt"
        
        ((success++))
        echo "✓ Created: $md_file"
    else
        echo "✗ Failed"
    fi
    
    echo ""
    
done < <(find "$SEARCH_DIR" -type f -name "*.mp3" -print0)

echo "================================================"
echo "Complete: $success/$total Markdown files created"
echo "================================================"
